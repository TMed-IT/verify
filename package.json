{
  "name": "verify",
  "version": "1.0.1",
  "description": "IT部のメールリンク認証サービス",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:worker": "node scripts/build.mjs && node --test checks/built-email.mjs",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:osv": "osv-scanner scan source --lockfile=pnpm-lock.yaml",
    "test": "vitest run && node --test checks/config.mjs checks/secrets-store.mjs checks/auth-tabs.mjs",
    "deploy:check": "pnpm build:worker && wrangler deploy --dry-run",
    "deploy:config:check": "dotenvx run --no-native --no-armor --strict -- node scripts/deploy.mjs --check",
    "deploy": "pnpm build:worker && dotenvx run --no-native --no-armor --strict -- node scripts/deploy.mjs",
    "db:schema:local": "wrangler d1 execute DB --local --config wrangler.test.jsonc --file schema.sql",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "keywords": [],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@dotenvx/dotenvx": "^2.38.2",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "next": "16.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
