{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verify-test",
  "main": "src/server/auth.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "verify" }],
  "ratelimits": [
    { "name": "FLOW_START_IP", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "FLOW_START_BROWSER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    { "name": "REQUEST_LINK_IP", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
    { "name": "REQUEST_LINK_BROWSER", "namespace_id": "2004", "simple": { "limit": 5, "period": 60 } }
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@verify.tmedit.org"] }],
  "secrets_store_secrets": [
    { "binding": "CLIENT_SECRET_MAIN", "store_id": "00000000000000000000000000000000", "secret_name": "CLIENT_SECRET_MAIN" },
    { "binding": "CLIENT_SECRET_ATND", "store_id": "00000000000000000000000000000000", "secret_name": "CLIENT_SECRET_ATND" },
    { "binding": "CLIENT_SECRET_CS", "store_id": "00000000000000000000000000000000", "secret_name": "CLIENT_SECRET_CS" }
  ],
  "vars": { "PUBLIC_ORIGIN": "http://localhost:3000" }
}
